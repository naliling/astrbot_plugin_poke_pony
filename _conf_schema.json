  "指令设置": {
    "description": "触发词与主动戳指令",
    "type": "object",
    "items": {
      "触发词": {
        "description": "模拟戳一戳的触发词",
        "type": "list",
        "hint": "消息内容完全等于触发词时生效，例如「戳一戳」「拍一拍」",
        "default": ["戳一戳", "戳戳", "拍一拍", "戳我", "nudge"]
      },
      "文本触发平台": {
        "description": "触发词生效的平台",
        "type": "list",
        "hint": "QQ/OneBot 有原生戳能力，默认不在列表里，避免文字重复触发",
        "default": [
          "telegram",
          "lark",
          "wecom",
          "wecom_ai_bot",
          "weixin_oc",
          "weixin_official_account",
          "qq_official",
          "qq_official_webhook",
          "dingtalk",
          "discord",
          "slack",
          "kook",
          "line",
          "misskey",
          "mattermost",
          "webchat"
        ]
      },
      "主动戳开关": {
