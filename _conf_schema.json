        "type": "bool",
        "default": true
      },
      "主动戳仅管理员": {
        "description": "仅管理员可以使用 /戳",
        "type": "bool",
        "default": false
      },
      "主动戳默认次数": {
        "description": "未指定次数时的默认回戳次数",
        "type": "int",
        "default": 1
      },
      "主动戳冷却秒数": {
        "description": "同一用户使用 /戳 的冷却",
        "type": "int",
        "default": 5
      }
    }
  },
