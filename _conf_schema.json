{
  "基础设置": {
    "description": "总开关、平台范围与防刷屏参数",
    "type": "object",
    "items": {
      "总开关": {
        "description": "插件总开关",
        "type": "bool",
        "hint": "关闭后不再响应任何戳一戳事件，指令也会提示已关闭",
        "default": true
      },
      "启用平台": {
        "description": "生效的平台适配器 ID",
        "type": "list",
        "hint": "留空表示全部平台生效。可填：aiocqhttp / telegram / lark / wecom / wecom_ai_bot / weixin_oc / qq_official 等",
        "default": []
      },
      "群聊启用": {
        "description": "是否在群聊中生效",
        "type": "bool",
        "default": true
      },
      "私聊启用": {
        "description": "是否在私聊中生效",
        "type": "bool",
        "default": true
      },
      "只响应戳机器人": {
        "description": "只响应「戳机器人自己」的事件",
        "type": "bool",
        "hint": "关闭后，群里 A 戳 B 也会触发机器人的反应（容易被当成刷屏，谨慎关闭）",
        "default": true
      },
      "机器人昵称": {
        "description": "模板变量 {bot} 的取值",
        "type": "string",
        "hint": "用于「{bot} 戳了戳 {target}」这类拟真文案",
        "default": "我"
      },
      "用户冷却秒数": {
        "description": "同一用户的响应冷却（秒）",
        "type": "int",
        "hint": "0 表示不冷却。建议 2-5 秒，防止连点刷屏",
        "default": 3
      },
      "每分钟上限": {
        "description": "全局每分钟最多响应次数",
        "type": "int",
        "hint": "0 表示不限制。超出后本分钟内的戳一戳会被静默丢弃",
        "default": 30
      },
      "去重窗口毫秒": {
        "description": "同一事件去重窗口（毫秒）",
        "type": "int",
        "hint": "部分协议端会同时推送消息段与通知事件，留 500-1000 即可",
        "default": 800
      },
      "安静时段开关": {
        "description": "启用夜间免打扰",
        "type": "bool",
        "default": false
      },
      "安静时段开始": {
        "description": "安静时段开始时间",
        "type": "string",
        "hint": "24 小时制，例如 23:30",
        "default": "23:30"
      },
      "安静时段结束": {
        "description": "安静时段结束时间",
        "type": "string",
        "hint": "支持跨零点，例如 07:00",
        "default": "07:00"
      }
    }
  },
  "发言设置": {
    "description": "被戳时的文字回应",
    "type": "object",
    "items": {
      "发言开关": {
        "description": "是否启用发言回应",
        "type": "bool",
        "default": true
      },
      "发言概率": {
        "description": "发言触发概率（百分比）",
        "type": "int",
        "hint": "0-100，100 表示每次都回应",
        "default": 100
      },
      "选取模式": {
        "description": "发言模板的抽取方式",
        "type": "string",
        "options": ["权重随机", "轮换", "洗牌袋"],
        "hint": "权重随机：按权重抽；轮换：按顺序循环；洗牌袋：一轮内不重复，最均匀",
        "default": "权重随机"
      },
      "附带艾特": {
        "description": "回应时是否 @ 戳你的人",
        "type": "bool",
        "hint": "仅对支持 At 消息段的平台生效（QQ / OneBot）",
        "default": true
      },
      "连击彩蛋阈值": {
        "description": "连戳多少次后切换到彩蛋模板",
        "type": "int",
        "hint": "0 表示关闭。连击判定窗口为 45 秒",
        "default": 5
      },
      "发言模板": {
        "description": "被戳时的回应模板",
        "type": "template_list",
        "templates": {
          "speech": {
            "name": "发言",
            "display_item": "发言内容",
            "items": {
              "启用发言": {
                "description": "是否启用该条发言",
                "type": "bool",
                "default": true
              },
              "发言内容": {
                "description": "发言内容，支持 {sender} {count} {streak} {bot} 等变量",
                "type": "string",
                "hint": "可用变量：{sender} {sender_id} {target} {bot} {group} {count} {streak} {time} {date} {platform}",
                "default": ""
              },
              "发言权重": {
                "description": "权重随机模式下的权重",
                "type": "int",
                "hint": "数值越大越容易被选中，建议 1-10",
                "default": 1
              }
            }
          }
        },
        "default": [
          {
            "__template_key": "speech",
            "启用发言": true,
            "发言内容": "（被戳得一激灵）谁啊！",
            "发言权重": 1
          },
          {
            "__template_key": "speech",
            "启用发言": true,
            "发言内容": "戳什么戳，再戳我可要还手了。",
            "发言权重": 1
          },
          {
            "__template_key": "speech",
            "启用发言": true,
            "发言内容": "在的在的，别戳啦～",
            "发言权重": 1
          },
          {
            "__template_key": "speech",
            "启用发言": true,
            "发言内容": "（抖了抖）今天第 {count} 次了，手指不疼吗？",
            "发言权重": 2
          },
          {
            "__template_key": "speech",
            "启用发言": true,
            "发言内容": "呜……轻点戳。",
            "发言权重": 1
          },
          {
            "__template_key": "speech",
            "启用发言": true,
            "发言内容": "有事说事，别光戳。",
            "发言权重": 1
          }
        ]
      },
      "连击彩蛋模板": {
        "description": "连击达到阈值后使用的模板",
        "type": "template_list",
        "templates": {
          "combo": {
            "name": "彩蛋",
            "display_item": "发言内容",
            "items": {
              "启用发言": {
                "description": "是否启用该条彩蛋",
                "type": "bool",
                "default": true
              },
              "发言内容": {
                "description": "彩蛋内容，支持 {streak} {sender} 等变量",
                "type": "string",
                "default": ""
              },
              "发言权重": {
                "description": "权重随机模式下的权重",
                "type": "int",
                "default": 1
              }
            }
          }
        },
        "default": [
          {
            "__template_key": "combo",
            "启用发言": true,
            "发言内容": "喂喂喂，{streak} 连戳了！手是租来的吗？",
            "发言权重": 1
          },
          {
            "__template_key": "combo",
            "启用发言": true,
            "发言内容": "再戳我就把「戳一戳」开关关掉（威胁）",
            "发言权重": 1
          },
          {
            "__template_key": "combo",
            "启用发言": true,
            "发言内容": "（炸毛）{sender} 你给我住手！",
            "发言权重": 1
          }
        ]
      }
    }
  },
  "回戳设置": {
    "description": "被戳之后是否戳回去，以及怎么戳",
    "type": "object",
    "items": {
      "回戳开关": {
        "description": "是否启用自动回戳",
        "type": "bool",
        "default": true
      },
      "回戳概率": {
        "description": "回戳触发概率（百分比）",
        "type": "int",
        "hint": "0-100，100 表示每次都回戳",
        "default": 100
      },
      "回戳次数": {
        "description": "每次回戳的次数",
        "type": "int",
        "hint": "仅原生回戳生效；拟真文案只发一条。0 表示不回戳",
        "default": 1
      },
      "回戳间隔毫秒": {
        "description": "多次回戳之间的间隔（毫秒）",
        "type": "int",
        "default": 300
      },
      "优先原生回戳": {
        "description": "优先使用平台原生戳一戳接口",
        "type": "bool",
        "hint": "关闭后即使平台支持原生戳，也改用拟真文案",
        "default": true
      },
      "原生失败降级": {
        "description": "原生回戳失败时改用拟真文案",
        "type": "bool",
        "hint": "强烈建议开启：这正是老版本插件「戳一下就报错」的修复点",
        "default": true
      },
      "链式回戳（实验）": {
        "description": "原生失败时尝试把 Poke 消息段塞进消息链",
        "type": "bool",
        "hint": "部分协议端支持，部分会报错；开启后失败仍会降级到拟真文案",
        "default": false
      },
      "回戳文案": {
        "description": "拟真回戳的默认文案",
        "type": "string",
        "hint": "支持 {bot} {target} {sender} {times} 等变量；具体平台可在「平台适配」里单独覆盖",
        "default": "（{bot} 反手戳了戳 {target}）"
      },
      "联动模式": {
        "description": "发言与回戳的联动方式",
        "type": "string",
        "options": ["发言与回戳独立", "回戳时不发言", "仅回戳时发言"],
        "default": "发言与回戳独立"
      }
    }
  },
